{
    "name": "mugiwara/laravel-feature-flags",
    "description": "A flexible feature flag package for Laravel with database, config, multi-tenancy, and percentage rollout support.",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "feature-flags", "feature-toggles", "rollout"],
    "authors": [
        {
            "name": "Sohaib bilal",
            "email": "sohaibhbill@gmail.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "illuminate/database": "^10.0|^11.0|^12.0",
        "illuminate/cache": "^10.0|^11.0|^12.0",
        "illuminate/http": "^10.0|^11.0|^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "phpunit/phpunit": "^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "MugiWara\\FeatureFlags\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MugiWara\\FeatureFlags\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "MugiWara\\FeatureFlags\\FeatureFlagsServiceProvider"
            ],
            "aliases": {
                "Feature": "MugiWara\\FeatureFlags\\Facades\\Feature"
            }
        }
    },
    "scripts": {
        "test": "phpunit",
        "test-coverage": "phpunit --coverage-html coverage"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
